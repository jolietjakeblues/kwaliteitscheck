# titel: Rijksmonument zonder gemeente
# dimensie: volledigheid
# populatie: actieve rijksmonumenten
# toelichting: Gemeente loopt via ceo:heeftBasisregistratieRelatie/ceo:heeftGemeente.
SELECT (SUM(?f) AS ?fout) (COUNT(?m) AS ?totaal) WHERE {
  GRAPH {G_INSTANTIES} { ?m ceo:heeftJuridischeStatus {JS_RIJKSMONUMENT} }
  BIND(IF(EXISTS { GRAPH {G_INSTANTIES} { ?m ceo:heeftBasisregistratieRelatie/ceo:heeftGemeente ?gm } }, 0, 1) AS ?f)
}
